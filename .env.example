# Copy to .env.local and fill in. Never commit the filled copy — .env.local is
# gitignored for that reason.

# ─── Required ────────────────────────────────────────────────────────────────

# Postgres. Neon in production; a local instance behind the neon-http proxy in
# development (see NEON_LOCAL_PROXY below).
DATABASE_URL=

# Signs the session cookie (HMAC-SHA256). Any long random string; changing it
# signs everyone out, which is also how you revoke every session at once.
AUTH_SECRET=

# ─── Local development only ──────────────────────────────────────────────────

# "true" points the neon-http driver at a local proxy on :4444, so development
# runs the exact same driver as production against plain Postgres in docker.
# MUST be unset in production — see docs/SECURITY_REVIEW.md §9.
NEON_LOCAL_PROXY=

# ─── AI providers (optional) ─────────────────────────────────────────────────
#
# The habit suggester tries these in order and falls through to the manual form
# if none answers. All three blank is a supported configuration, not a broken
# one: the Generate button is simply absent and every screen still works.
# Read by src/lib/ai/providers.ts and by nothing else.

GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# ─── Error reporting (optional) ──────────────────────────────────────────────

# Blank disables Sentry entirely. Errors only — no tracing, no session replay.
# What a report may carry is decided in src/lib/sentry-scrub.ts.
#
# Two names for the same value: SENTRY_DSN is the server/edge one and
# NEXT_PUBLIC_SENTRY_DSN the browser one. Setting only NEXT_PUBLIC_SENTRY_DSN
# configures all three runtimes, since the server falls back to it.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Source-map upload at build time — a build-time secret, distinct from the DSN.
# Optional: without it the build succeeds and simply skips the upload, leaving
# production stack traces minified. The org and project slugs are not secret
# and live in next.config.ts.
SENTRY_AUTH_TOKEN=
